{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:idc-skills:schema:root:v1",
  "title": "IDC Skills threshold root envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["signatures", "signed"],
  "properties": {
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/signature"}
    },
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["_type", "consistentSnapshot", "expires", "keys", "roles", "schema", "specVersion", "version"],
      "properties": {
        "_type": {"const": "root"},
        "consistentSnapshot": {"const": true},
        "expires": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "keys": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {"pattern": "^[0-9a-f]{64}$"},
          "additionalProperties": {"$ref": "#/$defs/key"}
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["release", "root"],
          "properties": {
            "release": {"$ref": "#/$defs/role"},
            "root": {"$ref": "#/$defs/role"}
          }
        },
        "schema": {"const": "idc-skills-root/v1"},
        "specVersion": {"const": "1.0"},
        "version": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keytype", "keyval", "scheme"],
      "properties": {
        "keytype": {"const": "ed25519"},
        "keyval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["public"],
          "properties": {"public": {"type": "string", "pattern": "^ssh-ed25519 [A-Za-z0-9+/]+={0,2}$"}}
        },
        "scheme": {"const": "ssh-ed25519"}
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyids", "threshold"],
      "properties": {
        "keyids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "threshold": {"type": "integer", "minimum": 1}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyid", "sig"],
      "properties": {
        "keyid": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sig": {"type": "string", "maxLength": 32768}
      }
    }
  }
}

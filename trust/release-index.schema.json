{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:idc-skills:schema:release-index:v1",
  "title": "IDC Skills signed release index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generatedAt",
    "indexSequence",
    "releases",
    "schema",
    "validUntil"
  ],
  "properties": {
    "generatedAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "indexSequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/releaseEntry"
      }
    },
    "schema": {
      "const": "idc-skills-release-index/v1"
    },
    "validUntil": {
      "$ref": "#/$defs/utcTimestamp"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "releaseEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gitCommit",
        "launcherSHA256",
        "manifestSHA256",
        "manifestSequence",
        "release",
        "verifierSHA256"
      ],
      "properties": {
        "gitCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "launcherSHA256": {
          "$ref": "#/$defs/digest"
        },
        "manifestSHA256": {
          "$ref": "#/$defs/digest"
        },
        "manifestSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "release": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "verifierSHA256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
